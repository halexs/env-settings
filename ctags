# universal-ctags options. `make ctags` links this to ~/.config/ctags/.
# universal-ctags understands TypeScript natively, so the old regex language
# definition is gone. Run `ctags -R .` (alias: re-ctag) in a project root.
--recurse=yes
--exclude=.git
--exclude=node_modules
--exclude=build
--exclude=dist
--exclude=.venv
--exclude=__pycache__
--exclude=*.min.js
--exclude=*.map
--exclude=tags
--exclude=package-lock.json
--fields=+ailmnS
--extras=+q
