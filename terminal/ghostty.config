# Ghostty (https://ghostty.org): installed to ~/.config/ghostty/config by
# `make terminal`. Works on macOS and Linux.
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 14

# tmux.conf uses Alt/Option bindings (M-h, M-n, M-r ...). Without this macOS
# types special characters instead.
macos-option-as-alt = true

window-padding-x = 8
window-padding-y = 6
window-save-state = always
copy-on-select = clipboard
cursor-style = bar
mouse-hide-while-typing = true
