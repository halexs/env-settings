#!/usr/bin/env bash
# Save and restore the sessions and windows of a running tmux server.
#
#   tmux-session save       write ~/.tmux-session
#   tmux-session restore    recreate sessions/windows from it
#
# TODO: persist and restore the layout of panes.
set -euo pipefail

STATE_FILE=${TMUX_SESSION_FILE:-$HOME/.tmux-session}
TAB=$'\t'

save() {
  tmux list-windows -a -F "#S${TAB}#W${TAB}#{pane_current_path}" > "$STATE_FILE"
  echo "saved $(wc -l < "$STATE_FILE" | tr -d ' ') windows to $STATE_FILE"
}

session_exists() { tmux has-session -t "=$1" 2>/dev/null; }

restore() {
  [ -r "$STATE_FILE" ] || { echo "no state file: $STATE_FILE" >&2; exit 1; }
  tmux start-server
  local count=0 session window dir
  local -a size=()
  if size_out=$(stty size 2>/dev/null); then
    size=(-x "${size_out#* }" -y "${size_out% *}")
  fi

  while IFS=$TAB read -r session window dir; do
    [ -d "$dir" ] || continue
    case $window in log|man) continue ;; esac
    if session_exists "$session"; then
      tmux new-window -d -t "$session:" -n "$window" -c "$dir"
    else
      tmux new-session -d -s "$session" -n "$window" -c "$dir" ${size[@]+"${size[@]}"}
      count=$((count + 1))
    fi
  done < "$STATE_FILE"

  echo "restored $count sessions"
}

case ${1:-} in
  save)    save ;;
  restore) restore ;;
  *) echo "usage: tmux-session save|restore" >&2; exit 1 ;;
esac
